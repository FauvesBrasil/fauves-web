# Builder.io API Key
# Get your key from https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=your_builder_key_here

# Backend API URL (local development)
VITE_BACKEND_URL=http://localhost:4000

# Backend API URL (production - create .env.production to override)
# VITE_API_BASE=https://your-backend-production-url.com
# VITE_BACKEND_URL=https://your-backend-production-url.com

# Supabase Configuration
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
