{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.fauves.com.br/sitemap.xml" },
    { "source": "/uploads/(.*)", "destination": "https://api.fauves.com.br/uploads/$1" },
    { "source": "/api/(.*)", "destination": "https://api.fauves.com.br/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
