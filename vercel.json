{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://fauves-backend-production.up.railway.app/sitemap.xml" },
    { "source": "/uploads/(.*)", "destination": "https://fauves-backend-production.up.railway.app/uploads/$1" },
    { "source": "/api/(.*)", "destination": "https://fauves-backend-production.up.railway.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
